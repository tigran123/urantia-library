# Per-machine config consumed by the urantia-library systemd unit.
# Copy to webapp/secrets.env and fill in. Not committed.

# Signs JWTs. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Falls back to a hardcoded dev string if unset (do NOT rely on that in prod).
JWT_SECRET_KEY=

# Auth cookie Secure flag.
# Dev (plain http on LAN): false. Prod (https): true or leave unset (secure-by-default).
COOKIE_SECURE=false

# "development" enables uvicorn --reload. Anything else (or unset) means prod.
APP_ENV=development

# SPA mount point. Drives both uvicorn --root-path and Vite base.
# Dev: leave unset (defaults to /). Prod: /library (matches the nginx prefix).
APP_ROOT_PATH=

# API base URL compiled into the SPA (frontend/src/api.ts). Defaults to /api,
# which is correct only when the app is served at the domain root. When the app
# is mounted under a prefix, set it to <prefix>/api — e.g. /library/api on the
# /library prod hosts — because the axios base does NOT derive from
# APP_ROOT_PATH. Baked in at BUILD time: changing it does nothing until
# frontend/dist is removed and rebuilt (see "Deploying to prod" in CLAUDE.md).
VITE_API_URL=

# Public base URL inserted into outgoing emails (digests, approvals, password resets).
# Dev example: http://lan.example.test:8000
# Prod example: https://library.example.com/library
APP_URL=

# Outbound SMTP credentials + the address that receives admin notifications.
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# Optional: override the filesystem root the API serves from. Defaults to /Books.
# BOOKS_DIR=/Books

# MaxMind GeoLite2 credentials. Sign up at https://www.maxmind.com/en/geolite2/signup
# (free) and generate a license key at Account → Manage License Keys.
# Consumed by scripts/update_geoip.sh to refresh the offline IP→geo database
# at /Books/.data/geoip/GeoLite2-City.mmdb.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Legal-document interpolation. The Privacy Policy and Terms of Service render
# from frontend/src/legal/*.md and pull these values from /api/legal/meta at
# render time. If LEGAL_CONTACT_EMAIL is unset the backend falls back to
# ADMIN_EMAIL above.
LEGAL_CONTACT_EMAIL=
