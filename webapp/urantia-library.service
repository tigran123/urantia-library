[Unit]
Description=Urantia Library
After=network-online.target nginx.service
Requires=nginx.service

[Service]
Type=simple
User=tigran
Group=tigran

WorkingDirectory=/Books/
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/Books/urantia-library/webapp/secrets.env
ExecStart=/Books/urantia-library/webapp/start.sh

Restart=always
RestartSec=5

# --- Security Constraints ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/Books/urantia-library/webapp/backend/ /Books/.data/ /Books/
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
