server {
    listen 80;
    server_name sigmaai.au;

    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name sigmaai.au;

    ssl_certificate /etc/letsencrypt/live/sigmaai.au/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sigmaai.au/privkey.pem;

    # Allow large document uploads (prevent 413 Request Entity Too Large)
    client_max_body_size 100M;

    # Redirect address without slash to address with slash
    location = /cashreconai {
        return 301 /cashreconai/;
    }

    # Proxy traffic to the CashReconAI Express server
    location /cashreconai/ {
        proxy_pass http://127.0.0.1:3002/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Disable buffering for SSE (streaming LLM responses)
        proxy_buffering off;

        # Extend timeouts for models that take a while to generate the first token
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
    }

    # The Urantia Library moved to a name of its own, https://ulib.sigmaai.au/,
    # on 2026-10-25 (ulib.sigmaai.au.nginx). Old addresses, in bookmarks and in
    # emails already sent, go there with their path and query: $request_uri is
    # the raw request, so an encoded path or token passes unchanged, and the
    # browser keeps a #/item/... fragment across the redirect by itself.
    location = /library {
        return 301 https://ulib.sigmaai.au/;
    }
    location ^~ /library/ {
        if ($request_uri ~ ^/library/(.*)$) {
            return 301 https://ulib.sigmaai.au/$1;
        }
    }
}
